#!/usr/bin/env bash
# Toolchains and dependencies: Rust (rustfmt, clippy, wasm32 target), the
# wasm-bindgen CLI matching Cargo.lock, fonttools for the glyph check.
# Idempotent. Runs from the project directory. With AVALON_CHANGED set it
# installs only what the affected parts need (see parts.sh).
set -euo pipefail
source .avalon/parts.sh

if [ "$P_RUST" = 1 ] || [ "$P_INSCRIPT" = 1 ] || [ "$P_RECOVERY" = 1 ] || [ "$P_WASM" = 1 ]; then
  rustup component add rustfmt clippy
else
  echo "setup: Rust toolchain skipped, not affected by this change"
fi

if [ "$P_WASM" = 1 ]; then
  rustup target add wasm32-unknown-unknown
  version=$(awk '/name = "wasm-bindgen"/{getline; gsub(/"/, "", $3); print $3; exit}' Cargo.lock)
  if ! command -v wasm-bindgen >/dev/null || [[ $(wasm-bindgen --version) != "wasm-bindgen $version" ]]; then
    cargo install wasm-bindgen-cli --version "$version" --locked
  fi
else
  echo "setup: wasm target and wasm-bindgen skipped, not affected by this change"
fi

# fonttools (pinned) lives in a gitignored venv so no system pip changes are needed.
if [ "$P_GLYPHS" = 1 ]; then
  if ! target/check-venv/bin/python -c 'import fontTools' 2>/dev/null; then
    python3 -m venv target/check-venv
    target/check-venv/bin/python -m pip install fonttools==4.61.1
  fi
else
  echo "setup: fonttools skipped, not affected by this change"
fi
